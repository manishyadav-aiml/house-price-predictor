# Copy this file to .env (git-ignored) and fill it in. NEVER commit the real .env.
APP_ENV=production            # use "development" only on your own machine over http://localhost
SECRET_KEY=                   # required, 32+ random chars:  python -c "import secrets;print(secrets.token_hex(32))"
PORT=5000
DATABASE_PATH=app.db
ALLOWED_ORIGINS=              # comma-separated sites allowed to call the API from a browser (empty = same site only)
AUTH_LIMIT=5                  # login/register attempts per minute per IP
